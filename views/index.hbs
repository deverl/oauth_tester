<header>
    <div class='image-block'>
        <img src='/images/logo.svg' alt='logo' />
    </div>
    <div id='setup_button'>
        <img src='/images/settings.svg' alt='settings' />
    </div>
    <div class='title-block'>
        <h1>{{header_text}}</h1>
    </div>
    <div class='config-name-block'>
        <div class='title'>Current Configuration: <span id='config_name_header'></span></div>
    </div>
</header>

<div>
    <div class='button' id='login_button' style='display:none;'>
        Login
    </div>
    <div class='button' id='request_token' style='display: none;'>
        Request Token
    </div>
    <div class='button' id='refresh_token_button' style='display: none;'>
        Refresh token
    </div>
    <div class='button' id='delete_token_button' style='display: none;'>
        Delete token
    </div>
</div>

<div>
    <pre id='response_body'></pre>
</div>

<div id='form_container'>
    <form name='oauth_config_form' id='oauth_config_form'>
        <div class='inner-container'>
            <!-- Title -->
            <div class='dialog-title'>OAuth Server Configuration</div>
            <div class='dialog-close-x'>
                <img src='/images/baseline-close-24px.svg' alt='close' />
            </div>
            <!-- Config list/chooser -->
            <div class='config-list-title'>Stored Configurations</div>
            <div id='config_list_container'>
                <div id='config_list'></div>
                <div id='config_list_button_container'>
                    <!-- Icon and text for add_new_config button -->
                    <div class='config-list-button' id='add_new_config'>
                        <i class='plus icon'></i>
                        <div class='config-button-title'>Add Config</div>
                    </div>
                </div>
            </div>
            <table>
                <!-- Config Name Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='config_name_input'>Config Name:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='config_name_input' name='config_name_input' placeholder='configuration name' />
                    </td>
                </tr>
                <!-- authorize_url Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='authorize_url_input'>Authorize URL:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='authorize_url_input' name='authorize_url_input' placeholder='https://yourhost.com/authorize' />
                    </td>
                </tr>
                <!-- token_url Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='token_url_input'>Token URL:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='token_url_input' name='token_url_input' placeholder='https://yourhost.com/token' />
                    </td>
                </tr>
                <!-- Client ID Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='client_id_input'>Client ID:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='client_id_input' name='client_id_input' placeholder='client id' />
                    </td>
                </tr>
                <!-- Client Secret Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='client_secret_input'>Client Secret:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='client_secret_input' name='client_secret_input' placeholder='client secret' />
                    </td>
                </tr>
                <!-- Scope Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='scope_input'>Scope (optional):</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='scope_input' name='scope_input' placeholder='space-separated scopes' />
                    </td>
                </tr>
            </table>

            <div class='button-row'>
                <input type='submit' id='form_submit_button' value='OK' class='ui primary button' />
            </div>
        </div>
    </form>
</div>
