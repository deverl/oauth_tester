<header>
    <div class='image-block'>
        <img src='/images/qb.svg' alt='logo' />
    </div>
    <div id='setup_button'>
        <img src='/images/settings.svg' alt='settings' />
    </div>
    <div class='title-block'>
        <h1>{{header_text}}</h1>
    </div>
    <div class='config-name-block'>
        <div class='title'>Current Configuration: <span id='config_name_header'></span></div>
    </div>
</header>

<div>
    <div class='button' id='login_to_tsheets' style='display:none;'>
        Login
    </div>
    <div class='button' id='request_token' style='display: none;'>
        Request Token
    </div>
    <div class='button' id='refresh_token_button' style='display: none;'>
        Refresh token
    </div>
    <div class='button' id='delete_token_button' style='display: none;'>
        Delete token
    </div>
</div>

<div>
    <pre id='response_body'></pre>
</div>

<div id='form_container'>
    <form name='oauth_config_form' id='oauth_config_form'>
        <div class='inner-container'>
            <!-- Title -->
            <div class='dialog-title'>API Server Configuration</div>
            <div class='dialog-close-x'>
                <img src='/images/baseline-close-24px.svg' alt='close' />
            </div>
            <!-- Config list/chooser -->
            <div class='config-list-title'>Stored Configurations</div>
            <div id='config_list_container'>
                <div id='config_list'></div>
                <div id='config_list_button_container'>
                    <!-- Icon and text for add_new_config button -->
                    <div class='config-list-button' id='add_new_config'>
                        <i class='plus icon'></i>
                        <div class='config-button-title'>Add Config</div>
                    </div>
                </div>
            </div>
            <table>
                <!-- Config Name Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='config_name_input'>Config Name:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='config_name_input' name='config_name_input' placeholder='configuration name' />
                    </td>
                </tr>
                <!-- Username Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='username_input'>Username:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='username_input' name='username_input' placeholder='username (client url)' />
                        <span>&nbsp;&nbsp;<i>(client url)</i></span>
                    </td>
                </tr>
                <!-- Server Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='server_input'>Server:</label>
                        </div>
                    </td>
                    <td>
                        <input type='text' id='server_input' name='server_input' placeholder='server name' />
                    </td>
                </tr>
                <!-- Client ID Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='client_id_input'>Client ID:</label>
                        </div>
                    </td>
                    <td>
                        <input type='password' id='client_id_input' name='client_id_input' placeholder='client id' />
                    </td>
                </tr>
                <!-- Client Secret Input -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <label for='client_secret_input'>Client Secret:</label>
                        </div>
                    </td>
                    <td>
                        <input type='password' id='client_secret_input' name='client_secret_input' placeholder='client secret' />
                    </td>
                </tr>
                <!-- e2e Checkbox -->
                <tr>
                    <td class='label-td'>
                        <div>
                            <span for='e2e_checkbox'>e2e:</span>
                        </div>
                    </td>
                    <td>
                        <input id='e2e_checkbox' type='checkbox' name='e2e' />
                    </td>
                </tr>
            </table>

            <div class='button-row'>
                <!--
                <button id="form_cancel_button">Cancel</button>
                -->
                <input type='submit' id='form_submit_button' value='OK' class='ui primary button' />
            </div>
        </div>
    </form>
</div>