<header>
    <div class='image-block'>
        <img src='/images/logo.svg' alt='logo' />
    </div>
    <div id='setup_button'>
        <img src='/images/settings.svg' alt='settings' />
    </div>
    <div class='title-block'>
        <h1>{{header_text}}</h1>
    </div>
    <div class='config-name-block'>
        <div class='title'>Current Configuration: <span id='config_name_header'></span></div>
    </div>
</header>

<div>
    <div class='button' id='login_button' style='display:none;'>
        Login
    </div>
    <div class='button' id='request_token' style='display: none;'>
        Request Token
    </div>
    <div class='button' id='refresh_token_button' style='display: none;'>
        Refresh token
    </div>
    <div class='button' id='delete_token_button' style='display: none;'>
        Delete token
    </div>
</div>

<div>
    <pre id='response_body'></pre>
</div>

<div id='form_container'>
    <form name='oauth_config_form' id='oauth_config_form'>
        <div class='inner-container'>
            <div class='dialog-header'>
                <div class='dialog-title'>Settings</div>
                <div class='dialog-close-x' title='Close'>
                    <img src='/images/baseline-close-24px.svg' alt='close' />
                </div>
            </div>

            <div class='settings-layout'>
                <aside class='settings-sidebar'>
                    <div class='config-list-title'>Configurations</div>
                    <div id='config_list'></div>
                    <div id='config_list_button_container'>
                        <button type='button' class='config-list-button' id='add_new_config' title='Add a blank configuration'>
                            <i class='plus icon'></i>
                            <span>New</span>
                        </button>
                        <button type='button' class='config-list-button' id='clone_config' title='Clone the current configuration'>
                            <i class='copy icon'></i>
                            <span>Clone</span>
                        </button>
                    </div>
                </aside>

                <div class='settings-form'>
                    <div class='settings-form-title'>Configuration details</div>
                    <div class='field-row'>
                        <label for='config_name_input'>Config Name</label>
                        <input type='text' id='config_name_input' name='config_name_input' placeholder='configuration name' autocomplete='off' />
                    </div>
                    <div class='field-row'>
                        <label for='authorize_url_input'>Authorize URL</label>
                        <input type='text' id='authorize_url_input' name='authorize_url_input' placeholder='https://yourhost.com/authorize' autocomplete='off' />
                    </div>
                    <div class='field-row'>
                        <label for='token_url_input'>Token URL</label>
                        <input type='text' id='token_url_input' name='token_url_input' placeholder='https://yourhost.com/token' autocomplete='off' />
                    </div>
                    <div class='field-row'>
                        <label for='client_id_input'>Client ID</label>
                        <input type='text' id='client_id_input' name='client_id_input' placeholder='client id' autocomplete='off' />
                    </div>
                    <div class='field-row'>
                        <label for='client_secret_input'>Client Secret</label>
                        <div class='secret-field'>
                            <div class='secret-input'>
                                <input type='password' id='client_secret_input' name='client_secret_input' placeholder='client secret' autocomplete='off' />
                                <button type='button' id='toggle_client_secret' class='secret-toggle' title='Show client secret' aria-label='Show client secret' aria-pressed='false'>
                                    <i class='eye icon'></i>
                                </button>
                            </div>
                            <label class='checkbox-label' for='public_client_input'>
                                <input type='checkbox' id='public_client_input' name='public_client_input' />
                                <span>Public client — no client secret (PKCE only)</span>
                            </label>
                        </div>
                    </div>
                    <div class='field-row'>
                        <label for='scope_input'>Scope <span class='optional'>(optional)</span></label>
                        <input type='text' id='scope_input' name='scope_input' placeholder='space-separated scopes' autocomplete='off' />
                    </div>

                    <div class='button-row'>
                        <span id='save_status' class='save-status' aria-live='polite'></span>
                        <input type='submit' id='form_submit_button' value='Save' class='ui primary button' />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
