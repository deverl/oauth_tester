<header>
    <div class="image-block">
        <img src="/images/qb.svg" alt="logo" />
    </div>
    <div id="setup_button">
        <img src="/images/settings.svg" alt="logo" />
    </div>
    <div class="title-block">
        <h1>{{title}}</h1>
    </div>
</header>

<div>
    <div class="button" id="login_to_tsheets" style="display:none;">
        Login
    </div>
    <div class="button" id="request_token" style="display: none;">
        Request Token
    </div>
    <div class="button" id="refresh_token_button" style="display: none;">
        Refresh token
    </div>
    <div class="button" id="delete_token_button" style="display: none;">
        Delete token
    </div>
</div>

<div>
    <pre id="response_body"></pre>
</div>

<div id="form_container">
    <form name="oauth_config_form" id="oauth_config_form">
        <div class="inner-container">
            <div class="dialog-title">API Server Configuration</div>
            <div class="dialog-close-x">
                <img src="/images/baseline-close-24px.svg" alt="close">
            </div>
            <table>
                <tr>
                    <td class="label-td">
                        <div>
                            <label for="username_input">Username:</label>
                        </div>
                    </td>
                    <td>
                        <input type="text" id="username_input" name="username_input"
                            placeholder="username (client url)" />
                        <span>&nbsp;&nbsp;<i>(client url)</i></span>
                    </td>
                </tr>
                <tr>
                    <td class="label-td">
                        <div>
                            <label for="client_id_input">Client ID:</label>
                        </div>
                    </td>
                    <td>
                        <input type="password" id="client_id_input" name="client_id_input" placeholder="client_id" />
                    </td>
                </tr>
                <tr>
                    <td class="label-td">
                        <div>
                            <label for="client_secret_input">Client Secret:</label>
                        </div>
                    </td>
                    <td>
                        <input type="password" id="client_secret_input" name="client_secret_input"
                            placeholder="client_secret" />
                    </td>
                </tr>
                <tr>
                    <td class="label-td">
                        <div>
                            <span for="api_server">API Server:</span>
                        </div>
                    </td>
                    <td>
                        <input id="armorweb01_radio" type="radio" name="api_server" value="armorweb01" />
                        <label for="armorweb01_radio">armorweb01</label>
                        <input id="amorweb_prd_radio" type="radio" name="api_server" value="amorweb-prd" />
                        <label for="amorweb_prd_radio">amorweb-prd</label>
                    </td>
                </tr>
            </table>

            <div class="button-row">
                <!--
                <button id="form_cancel_button">Cancel</button>
                -->
                <input type="submit" id="form_submit_button" value="OK" class="ui primary button">
            </div>
        </div>
    </form>
</div>
